# Prerequisites
*.d

# Folders
/Debug
/x64
/.vs

# CMake build trees (fetched dependencies live in build/<preset>/_deps)
/build
/out
CMakeUserPresets.json

# Visual Studio build-insights / profiling dumps
compileData.scor*
*.aps

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Render output dumped at the repository root
*.ppm
*.bmp
/RenderImage1.jpg
/carRender.jpg
/carReflection.jpg
*.hdr
*.jpg

# models/ holds scene assets the renderer loads at run time, so they must be
# committed even though the textures match the image rules above. Excluding the
# whole directory silently drops every asset added after the tracked ones.
!models/**
models/.mayaSwatches/
